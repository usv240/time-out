NUTRIENT_DWS_USER=
NUTRIENT_DWS_PASS=
NUTRIENT_DWS_API_KEY=

# ── Doctavian ───────────────────────────────────────────────────
# Request from hello@doctavian.com
DOCTAVIAN_API_KEY=
DOCTAVIAN_BASE_URL=

# ── name.com CORE (sandbox) ─────────────────────────────────────
# Basic auth: base64(username:token). Creds take ~15 min to activate.
NAMECOM_USERNAME=
NAMECOM_TOKEN=
NAMECOM_BASE_URL=https://api.dev.name.com
NAMECOM_REGISTRY_DOMAIN=

# ── Perfect Corp (YouCam) ───────────────────────────────────────
# Console: yce.perfectcorp.com/api-console
PERFECTCORP_API_KEY=
PERFECTCORP_SECRET=

# ── SerpApi ─────────────────────────────────────────────────────
SERPAPI_KEY=

# ── Xano ────────────────────────────────────────────────────────
XANO_INSTANCE_URL=
XANO_API_KEY=

# ── Foxit ───────────────────────────────────────────────────────
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
