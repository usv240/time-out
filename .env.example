# ── Nutrient DWS ────────────────────────────────────────────────
# Campaign: api.nutrient.io/campaigns/api-world-cloudx-ai-hackathon-2026/
NUTRIENT_DWS_USER=
NUTRIENT_DWS_PASS=
# Processor API key (works: /build, /analyze_build)
NUTRIENT_PROCESSOR_API_KEY=

# Data Extraction API key — SEPARATE product, same dashboard
NUTRIENT_EXTRACTION_API_KEY=
# Optional override; must point to a SHA-bound synthetic PDF + .synthetic.json manifest
NUTRIENT_SOURCE_PDF=

# Viewer API key (if separately issued)
NUTRIENT_VIEWER_API_KEY=

# ── Doctavian ───────────────────────────────────────────────────
# Request from hello@doctavian.com
DOCTAVIAN_API_KEY=
# Google Drive-scoped bearer after authorizing Doctavian storage
DOCTAVIAN_BEARER=
DOCTAVIAN_BASE_URL=
DOCTAVIAN_ORIGIN=https://app.mavenmule.com
# Controlled synthetic demo inboxes only; never patient or clinic addresses
DOCTAVIAN_PATIENT_EMAIL=
DOCTAVIAN_INJECTOR_EMAIL=
# ── name.com CORE (sandbox) ─────────────────────────────────────
# Basic auth: base64(username:token). Creds take ~15 min to activate.
NAMECOM_USERNAME=
NAMECOM_TOKEN=
NAMECOM_BASE_URL=https://api.dev.name.com
NAMECOM_REGISTRY_DOMAIN=timeout-receipts-demo.com

# ── Perfect Corp (YouCam) ───────────────────────────────────────
# Console: yce.perfectcorp.com/api-console
PERFECTCORP_API_KEY=
PERFECTCORP_SECRET=

# ── SerpApi ─────────────────────────────────────────────────────
SERPAPI_KEY=

# ── Xano ────────────────────────────────────────────────────────
XANO_INSTANCE_URL=
XANO_API_KEY=

# ── Foxit ───────────────────────────────────────────────────────
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
